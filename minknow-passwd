#!/opt/minknow-dashboard/venv/bin/python
import os
import sys
import json
import getpass
import subprocess
import grp
from werkzeug.security import generate_password_hash

def main():
    if os.geteuid() != 0:
        print("Please run as root (e.g., sudo minknow-passwd)")
        sys.exit(1)

    config_dir = "/etc/minknow-dashboard"
    config_file = os.path.join(config_dir, "config.json")
    app_dir = os.path.dirname(os.path.realpath(__file__))
    lockout_file = os.path.join(app_dir, "state", "lockout.db")

    # Handle unlock argument
    if len(sys.argv) > 1 and sys.argv[1] in ('--unlock', '-u'):
        if os.path.exists(lockout_file):
            os.remove(lockout_file)
            print("Account unlocked successfully.")
        else:
            print("Account is not currently locked.")
        sys.exit(0)

    print("--- MinKNOW Dashboard Credentials ---")
    
    # Prompt for credentials safely (supports interactive dpkg install)
    try:
        new_user = input("Enter new username: ").strip()
        new_pass = getpass.getpass("Enter new password: ")
        new_pass_confirm = getpass.getpass("Confirm new password: ")
    except EOFError:
        print("\nNon-interactive shell detected. Aborting password change.")
        sys.exit(1)

    if not new_user or not new_pass:
        print("Username and password cannot be empty. Aborting.")
        sys.exit(1)

    if new_pass != new_pass_confirm:
        print("Passwords do not match. Aborting.")
        sys.exit(1)

    os.makedirs(config_dir, exist_ok=True)
    
    # Write credentials in plaintext directly, as the directory is protected
    # by root permissions (755) and the config file is 640 root:minknow.
    # An attacker who can read this already has full system access.
    with open(config_file, 'w') as f:
        json.dump({"username": new_user, "password": new_pass}, f)

    try:
        uid = 0 # root
        gid = grp.getgrnam('minknow').gr_gid
        os.chown(config_file, uid, gid)
        os.chmod(config_file, 0o640)
    except KeyError:
        print("Warning: minknow group not found, keeping strict root ownership.")
        os.chmod(config_file, 0o600)

    if os.path.exists(lockout_file):
        os.remove(lockout_file)
        print("Existing lockout reset.")

    print(f"Credentials updated successfully in {config_file}.")

    # Restart service if running
    try:
        result = subprocess.run(['systemctl', 'is-active', '--quiet', 'minknow-dashboard.service'])
        if result.returncode == 0:
            subprocess.run(['systemctl', 'restart', 'minknow-dashboard.service'])
            print("Service restarted to apply changes.")
        else:
            print("Service is not currently running. Changes will take effect on next start.")
    except Exception as e:
        print(f"Could not check/restart service: {e}")

if __name__ == "__main__":
    main()
